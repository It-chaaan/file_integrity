# ============================================
# File Integrity Verification System
# Backend Integration Configuration
# ============================================
# STATUS: Backend Integration Mode (Real API)
# Last Updated: January 22, 2026
# ============================================

# Django Backend API
# TODO: Update with your actual backend URL
# Local: http://localhost:8000/api/v1
# Staging: https://staging-api.yourcompany.com/api/v1
# Production: https://api.yourcompany.com/api/v1
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Application Settings
VITE_APP_NAME=PARITY
VITE_APP_DESCRIPTION=LGU Legal Documents Verification System

# Session & Token Storage Keys
VITE_TOKEN_KEY=parity_auth_token
VITE_REFRESH_KEY=parity_refresh_token

# ============================================
# API MODE CONFIGURATION (CRITICAL)
# ============================================
# BACKEND INTEGRATION: Set to 'false' to use real Django API
# DEVELOPMENT/TESTING: Set to 'true' to use mock data
VITE_USE_MOCK_API=true

# ============================================
# FILE UPLOAD LIMITS
# ============================================
# Max file size: 5MB (in bytes)
VITE_MAX_FILE_SIZE=5242880
# Allowed file extensions
VITE_ALLOWED_FILE_TYPES=.pdf,.doc,.docx,.txt

# ============================================
# ENVIRONMENT SETTINGS
# ============================================
# Environment: development, staging, production
VITE_ENV=development

# Debug Mode (disable for production)
VITE_DEBUG=true

# Security: HTTPS enforcement (enable for production)
VITE_HTTPS_ONLY=false

# ============================================
# FEATURE FLAGS
# ============================================
VITE_ENABLE_2FA=true
VITE_ENABLE_FILE_UPLOAD=true
VITE_ENABLE_PUBLIC_VERIFY=true

# ============================================
# API CONFIGURATION
# ============================================
VITE_API_TIMEOUT=30000
VITE_SESSION_TIMEOUT=3600000

# ============================================
# BACKEND INTEGRATION CHECKLIST
# ============================================
# ✅ VITE_USE_MOCK_API set to 'false'
# ✅ VITE_API_BASE_URL points to backend server
# ⚠️ Backend server must be running
# ⚠️ CORS must be enabled on backend
# ⚠️ All endpoints must match API layer expectations
# ============================================
