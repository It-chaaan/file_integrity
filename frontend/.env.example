# ============================================
# File Integrity Verification System
# Environment Configuration Template
# ============================================
# 
# INSTRUCTIONS:
# 1. Copy this file to `.env` in the same directory
# 2. Update values according to your environment
# 3. Never commit `.env` to version control
#
# ============================================

# ============================================
# API CONFIGURATION
# ============================================

# API Mode: MOCK or REAL
# - MOCK: Uses local mock data (for development without backend)
# - REAL: Connects to actual backend API
VITE_API_MODE=MOCK

# Backend API Base URL
# Development: http://localhost:8000/api/v1
# Staging: https://staging-api.yourcompany.com/api/v1
# Production: https://api.yourcompany.com/api/v1
VITE_API_BASE_URL=http://localhost:8000/api/v1

# API Request Timeout (milliseconds)
# Default: 30000 (30 seconds)
VITE_API_TIMEOUT=30000

# ============================================
# AUTHENTICATION CONFIGURATION
# ============================================

# Token Storage Key (localStorage key name)
VITE_AUTH_TOKEN_KEY=authToken

# Storage Type: localStorage or sessionStorage
# - localStorage: Persists across browser sessions
# - sessionStorage: Cleared when browser tab closes
VITE_AUTH_STORAGE=localStorage

# Session Timeout (milliseconds)
# How long before inactive user is logged out
# Default: 3600000 (1 hour)
VITE_SESSION_TIMEOUT=3600000

# ============================================
# FEATURE FLAGS
# ============================================

# Enable Two-Factor Authentication
VITE_ENABLE_2FA=true

# Enable File Upload Feature
VITE_ENABLE_FILE_UPLOAD=true

# Enable Public Document Verification
VITE_ENABLE_PUBLIC_VERIFY=true

# Enable Audit Log Export
VITE_ENABLE_LOG_EXPORT=true

# ============================================
# FILE UPLOAD CONFIGURATION
# ============================================

# Maximum File Size (bytes)
# 10MB = 10485760
# 50MB = 52428800
# 100MB = 104857600
VITE_MAX_FILE_SIZE=10485760

# Allowed File Types (comma-separated)
VITE_ALLOWED_FILE_TYPES=.pdf,.doc,.docx,.txt

# ============================================
# PAGINATION CONFIGURATION
# ============================================

# Default Items Per Page
VITE_DEFAULT_PAGE_SIZE=10

# Maximum Items Per Page
VITE_MAX_PAGE_SIZE=100

# ============================================
# ENVIRONMENT
# ============================================

# Environment: development, staging, production
VITE_ENV=development

# Enable Debug Mode (shows console logs)
VITE_DEBUG=true

# Application Version
VITE_APP_VERSION=1.0.0

# ============================================
# SECURITY SETTINGS
# ============================================

# Enable HTTPS Only (production should be true)
VITE_HTTPS_ONLY=false

# Enable Content Security Policy
VITE_ENABLE_CSP=true

# ============================================
# OPTIONAL: THIRD-PARTY INTEGRATIONS
# ============================================

# Analytics (Google Analytics, etc.)
# VITE_ANALYTICS_ID=

# Error Tracking (Sentry, etc.)
# VITE_SENTRY_DSN=

# ============================================
# NOTES FOR BACKEND TEAM
# ============================================
#
# 1. API Base URL must end with /api/v1 (or your API version)
# 2. Backend must enable CORS for the frontend origin
# 3. JWT tokens should be returned in response.data.token
# 4. All authenticated endpoints expect: Authorization: Bearer {token}
# 5. Response format must match:
#    Success: { success: true, data: {...} }
#    Error: { success: false, error: { code, message } }
#
# ============================================
