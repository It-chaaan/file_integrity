# --- Django / Python Specific ---
__pycache__/
*.py[cod]
*$py.class
venv/
env/
db.sqlite3
media/

# --- Documentation & Design ---
# Ignore large Figma exports or raw design assets that don't belong in Git
# (Assuming your 'design figma' folder contains large binaries)
design figma/*.fig
design figma/*.pdf

# --- Build Tools ---
# If you use Vite, 'dist' is already covered, but let's be sure
/dist
/out

# --- Project Specific ---
# Since you have a requirements.txt in the wrong spot, let's ignore 
# any local python env files if they exist in the frontend
.python-version

frontend/node_modules/