DJANGO_ENV=development
DJANGO_SECRET_KEY=replace_me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173

POSTGRES_DB=ecommerce_secure_db
POSTGRES_TEST_DB=ecommerce_secure_db_test
POSTGRES_USER=app_user
POSTGRES_PASSWORD=app_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

PARITY_KEY_ENCRYPTION_SECRET=replace_with_a_long_random_secret
PARITY_MFA_ENCRYPTION_SECRET=replace_with_a_long_random_secret_for_mfa_or_leave_blank_to_fallback_to_parity_key_encryption_secret
DJANGO_TRUST_PROXY_HEADERS=true

DJANGO_LOG_LEVEL=INFO
