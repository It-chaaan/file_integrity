DJANGO_ENV=development
DJANGO_SECRET_KEY=replace_me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173

POSTGRES_DB=ecommerce_secure_db
POSTGRES_TEST_DB=ecommerce_secure_db_test
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

DJANGO_FILE_UPLOAD_MAX_MEMORY_SIZE=12582912
DJANGO_DATA_UPLOAD_MAX_MEMORY_SIZE=12582912

DJANGO_THROTTLE_ANON=60/min
DJANGO_THROTTLE_USER=300/min
DJANGO_THROTTLE_AUTH_BURST=10/min
DJANGO_THROTTLE_AUTH_SENSITIVE=5/min

DJANGO_SECURE_REFERRER_POLICY=same-origin
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false
DJANGO_X_FRAME_OPTIONS=DENY

DJANGO_LOG_LEVEL=INFO

DJANGO_SPECTACULAR_TITLE=File Integrity API
DJANGO_SPECTACULAR_DESCRIPTION=API contract for File Integrity (standard response envelope).
DJANGO_SPECTACULAR_VERSION=1.0.0
